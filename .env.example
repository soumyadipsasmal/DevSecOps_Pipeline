# KaliNova — environment variables read by app/config.js
#
# Copy to .env (gitignored) and fill in real values. Never commit a filled-in
# copy. Every value below is empty on purpose: this file carries no secret.
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Defaults shown in the comments are what the app uses when the variable is
# unset. Compose also reads ADMIN_SESSION_SECRET, APP_PORT and DB_HOST_PORT
# from this file; DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD are read
# by app/db.js from app/.env when you run the server outside Docker.

# --- Process -------------------------------------------------------------
NODE_ENV=
PORT=

# --- Database --------------------------------------------------------------
# One PostgreSQL connection string, e.g. the one Neon gives you for the
# "production" branch. When it is set, app/db.js connects over TLS using only
# this URL and ignores DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD.
# Leave it blank to keep using the Docker Compose database, whose DB_* values
# are read from app/.env when the server runs outside Docker.
DATABASE_URL=your_neon_postgresql_connection_string

# --- Admin session -------------------------------------------------------
# Signs the admin session cookie. At least 32 characters, and in production it
# must not look like a placeholder; the app refuses to start otherwise.
ADMIN_SESSION_SECRET=
# Legacy fallback for ADMIN_SESSION_SECRET on older deployments.
JWT_SECRET=
# ADMIN_SESSION_MINUTES=480            # 5–10080
# ADMIN_COOKIE_NAME=kalinova_admin_session
# ADMIN_CSRF_COOKIE_NAME=kalinova_admin_csrf
# ADMIN_COOKIE_SECURE=true             # defaults to true when NODE_ENV=production

# --- Sign-in rate limiting ----------------------------------------------
# ADMIN_BCRYPT_ROUNDS=12               # 10–15
# ADMIN_LOGIN_ATTEMPTS=8               # 1–100 per window, per IP + email
# ADMIN_LOGIN_WINDOW_MINUTES=15        # 1–1440

# --- Request limits ------------------------------------------------------
# ADMIN_ARTICLE_BODY_KB=512            # 32–4096, article JSON bodies
# ADMIN_UPLOAD_MAX_KB=6144             # 64–20480, banner uploads

# --- Behind a reverse proxy ---------------------------------------------
# TRUST_PROXY=false                    # true, false, or a hop count

# --- Open-data integrations (Wikidata / Commons / OSM / RSS) -------------
# Nothing here is secret and nothing here is required: every value has a
# working default in app/config.js, so leaving them unset runs the site
# exactly as shipped. Overrides exist mainly for self-hosting a tile server
# or pointing the test suite at a local fixture.
#
# CONTACT_EMAIL=soumyadipsasmal88@gmail.com   # UA contact for Wikimedia APIs (must be an email)
# SITE_URL=https://kalinova.in                # origin used in the User-Agent string
# OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png   # must contain {z} {x} {y}
# GEOCODER_URL=https://nominatim.openstreetmap.org             # geocode base, http(s) only
# EXTERNAL_FETCH_TIMEOUT_MS=5000             # 1000–30000, per outbound request
# WIKIDATA_API_URL=https://www.wikidata.org/w/api.php           # test override
# COMMONS_API_URL=https://commons.wikimedia.org/w/api.php       # test override

# --- Open-data automatic safety (Phase 2) --------------------------------
# ENABLE_WIKIDATA=true   # master switch for the Wikidata lookups
# ENABLE_COMMONS=true    # master switch for the Commons metadata lookups
# ENABLE_MAPS=true       # master switch for OSM tiles + Nominatim geocoding
# ENABLE_RSS=true        # master switch for the reviewed RSS headline strip
# An ENABLE_* flag set to false disables the service no matter what the
# circuit breakers or this UI say; it always wins.
#
# --- Circuit breaker tuning ----------------------------------------------
# A breaker opens on N consecutive failures, or when more than CB_FAILURE_RATE
# of the last CB_MIN_REQUESTS requests failed inside CB_WINDOW_MINUTES, or on
# an immediate 401/403/429 (429 honours Retry-After). After CB_COOLDOWN_MS one
# probe is let through; another failure doubles the cooldown up to
# CB_MAX_COOLDOWN_MS. Three 403 answers in 24h lock the service until an
# administrator re-enables it on /admin/integrations.
# CB_FAILURE_THRESHOLD=5            # 2–100 consecutive failures
# CB_WINDOW_MINUTES=10              # 1–1440 trailing window
# CB_MIN_REQUESTS=10                # 3–10000 minimum samples for the rate rule
# CB_FAILURE_RATE_PERCENT=50        # 1–100, rate above this opens the breaker
# CB_COOLDOWN_MS=300000             # 1000–86400000 first cooldown
# CB_MAX_COOLDOWN_MS=21600000       # 60000–604800000 ceiling after doubling
# CB_FORBIDDEN_DAILY_MAX=3          # 403s per 24h before the 403 lock
# CB_EVENT_RETENTION_DAYS=90        # integration_events are swept after this
#
# --- Request envelopes (hourly / daily per service) ----------------------
# Once an envelope is spent, further outbound calls for that service are
# refused and whatever is cached is served instead.
# NOMINATIM_HOURLY_LIMIT=60
# NOMINATIM_DAILY_LIMIT=1000
# WIKIDATA_HOURLY_LIMIT=600
# WIKIDATA_DAILY_LIMIT=5000
# COMMONS_HOURLY_LIMIT=600
# COMMONS_DAILY_LIMIT=5000
# RSS_HOURLY_LIMIT=24
# RSS_DAILY_LIMIT=192
# RSS_MIN_INTERVAL_MS=900000        # min gap between two fetches of one feed
#
# --- Map tile health probe ------------------------------------------------
# The server fetches the 0/0/0 tile every MAP_TILE_HEALTHCHECK_MS through the
# map_tiles breaker; while it is open the frontend renders a text destination
# index instead of the map.
# MAP_TILE_HEALTHCHECK_MS=1800000
# MAP_TILE_HOURLY_LIMIT=4
# MAP_TILE_DAILY_LIMIT=96

# --- Monetization ----------------------------------------------------------
# None of these switch advertising on: KaliNova is not monetised. They only
# configure how the monetization dashboard stores its (anonymised) event data
# and which address a future email provider would display as the sender.
#
# ANALYTICS_SALT is a server secret used to HMAC client addresses so the
# affiliate click / direct-ad event logs keep no raw IPs. Generate it like the
# session secret. When unset, events are recorded with an empty hash — still
# no raw IPs, and no per-visitor signal at all.
# ANALYTICS_SALT=
# NEWSLETTER_FROM_EMAIL=                 # display address if a provider is wired in
# NEWSLETTER_PROVIDER=                   # e.g. "resend" / "mailgun" — no sending enabled

# --- SEO engine & redirects --------------------------------------------------
# ENABLE_SEO_ENGINE=true                 # master switch for the admin SEO panel
# SEO_INTERNAL_LINK_LIMIT=5              # 0–20 related-story suggestions per run
