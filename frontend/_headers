# Cloudflare Pages / Netlify headers for KaliNova.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # The page must work whether or not the Google Fonts stylesheet loads.
  #
  # This policy stays closed by default: scripts, connections and images are
  # same-origin, so nothing reaches a third party on the shipped build.
  #
  # ANALYTICS IS OFF BY DEFAULT. The googletagmanager / google-analytics origins
  # below are only ever *contacted* after an operator sets GA_MEASUREMENT_ID and
  # the reader grants advertising consent; assets/analytics.js makes no request
  # otherwise, so allowing the origins here does not by itself track anyone. If
  # the analytics feature is never used, these entries are inert.
  #
  # ADS / ADSENSE ARE NOT YET ENABLED. The site ships with no publisher ID and
  # no slot IDs, so nothing to serve. If you switch ads on in
  # /admin/ads, this policy has to be widened in the same deploy, or the ad
  # script will be blocked and the reserved slot space will stay empty. The
  # exact directives to add are:
  #
  #   script-src  += https://pagead2.googlesyndication.com
  #                 https://googleads.g.doubleclick.net
  #   img-src     += https: data: https://*.googlesyndication.com
  #                 https://*.doubleclick.net https://*.google.com
  #   connect-src += https://googleads.g.doubleclick.net
  #                 https://pagead2.googlesyndication.com
  #                 https://csi.gstatic.com
  #   frame-src   += https://googleads.g.doubleclick.net
  #                 https://tpc.googlesyndication.com
  #                 https://www.google.com
  #   child-src   += https://googleads.g.doubleclick.net
  #
  # Keep 'self' first in every list, and do not add 'unsafe-inline' or 'unsafe-eval':
  # AdSense does not need either, and both would undo the point of the policy.
  #
  # Scope: this file is Cloudflare Pages / Netlify. The Express app in app/ sends
  # its own stricter policy from app/config.js (adminCsp) for /admin only; the
  # public surface relies on this file plus a reverse proxy. If you put the
  # Express app directly in front of readers, it has to send an equivalent
  # public policy of its own.
  #
  # MAP TILES: img-src also allows the OpenStreetMap tile host, because the
  # Travel destination map loads raster tiles as <img> elements. Leaflet itself
  # is vendored under /vendor/leaflet (script-src stays 'self'), and tiles are
  # the only new outbound origin in the policy. Self-hosted tile servers just
  # need OSM_TILE_URL set and this host entry updated to match.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://*.tile.openstreetmap.org https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Fingerprinted-by-content assets are not fingerprinted here, so keep the cache
# short and revalidate. Static files are served straight from disk.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff

/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/*.js
  Cache-Control: public, max-age=3600, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=1800